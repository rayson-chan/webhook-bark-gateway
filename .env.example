# Bark server is already listening on the Docker host. Do not use 127.0.0.1
# here: inside the gateway container it would refer to the container itself.
BARK_BASE_URL=http://host.docker.internal:8080
BARK_DEVICE_KEY=replace-with-your-bark-device-key
BARK_TIMEOUT_SECONDS=10

# Each source has independent credentials. Use long random values.
# Clients may send the token as Authorization: Bearer <token>,
# X-Webhook-Token: <token>, or ?token=<token>.
TAILSCALE_TOKEN=
PASEO_TOKEN=replace-with-a-long-random-token
GENERIC_TOKEN=replace-with-a-different-long-random-token

# If set, Tailscale's native signature is required and verified. This is the
# preferred authentication for Tailscale; TAILSCALE_TOKEN may then be blank.
TAILSCALE_WEBHOOK_SECRET=
TAILSCALE_SIGNATURE_TOLERANCE_SECONDS=300

LOG_LEVEL=INFO
MAX_BODY_BYTES=1048576

